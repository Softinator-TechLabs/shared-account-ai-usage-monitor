# Private deployment settings. Generate a URL-safe password: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-private-random-hex
PUBLIC_ORIGIN=https://usage.example.com
TEAM_WORKSPACE=team
AUTH_MODE=password
OWNER_EMAIL=owner@example.com
# Optional private 64-hex bootstrap token for headless deployment.
OWNER_SETUP_TOKEN=
INITIAL_POLICY={"version":1,"content":"full","redaction":"none","visibility":"team","retention_days":90}
# Optional OIDC: use AUTH_MODE=both or oidc, map exact verified subject IDs.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OWNER_OIDC_SUBJECT=

# Optional viewer-key encryption: base64 random 32 bytes; preserve in secret backups.
VIEWER_ENCRYPTION_KEY=
